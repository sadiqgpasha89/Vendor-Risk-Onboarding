# Copy to .env (git-ignored). Real environment variables override this file. Nothing here is a real secret.
APP_ENV=local
VRO_DB_PATH=./data/vro.db
VRO_POLICY_PACK=default
VRO_DEV_AUTH=1                  # MUST be 0 outside a laptop. Then set the OIDC_* variables below.

# =====================================================================================================
# LLM: pick ONE provider block. "rules" = offline deterministic baseline (no model, no network).
# After editing:   python -m evals.live --quick --yes      (smoke)      |   python -m evals.live --yes   (full)
# Model ids change often: check the provider's current model list and set LLM_MODEL_* explicitly.
# =====================================================================================================
LLM_PROVIDER=rules

# ---- A) Ollama (local, free, private).  ollama serve ; ollama pull llama3.1:8b ; ollama pull qwen2.5:14b
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL_SMALL=llama3.2:3b
# LLM_MODEL_MID=llama3.1:8b          # Reader, narrative, drafts
# LLM_MODEL_LARGE=qwen2.5:14b        # independent Verifier - use a DIFFERENT, stronger model than the Reader if you can
# LLM_NUM_CTX=16384                  # Ollama's default context is tiny and silently truncates documents; keep >= 16384
# LLM_OLLAMA_SCHEMA=0                # 1 = pass JSON schema as grammar (more reliable on small models, needs a recent Ollama)

# ---- B) Google Gemini (API key from Google AI Studio)
# LLM_PROVIDER=google
# LLM_API_KEY=your-google-api-key
# LLM_MODEL_SMALL=gemini-2.0-flash
# LLM_MODEL_MID=gemini-2.0-flash
# LLM_MODEL_LARGE=gemini-2.5-pro
# LLM_PRICE_IN_PER_M=0.10            # USD per 1M input tokens - fill from current pricing so per-case budgets bite (0 = unmetered)
# LLM_PRICE_OUT_PER_M=0.40

# ---- C) Any OpenAI-compatible server (OpenAI, vLLM, LM Studio, llama.cpp, LiteLLM, OpenRouter)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com      # LM Studio: http://localhost:1234/v1
# LLM_API_KEY=your-key
# LLM_MODEL_MID=gpt-4o-mini
# LLM_MODEL_LARGE=gpt-4o
# LLM_JSON_MODE=1                    # set 0 if your server rejects response_format

# ---- D) Anthropic
# LLM_PROVIDER=anthropic
# LLM_API_KEY=your-key
# LLM_MODEL_SMALL=claude-haiku-5-5
# LLM_MODEL_MID=claude-sonnet-5-5
# LLM_MODEL_LARGE=claude-opus-5-5

LLM_TIMEOUT_S=180
LLM_ALLOW_FALLBACK=0               # 1 = on model failure use the rules baseline for that call (hides failures; never for evals)
BUDGET_USD_T1=60
BUDGET_USD_T2=30
BUDGET_USD_T3=10
BUDGET_USD_T4=3

SCREEN_REVIEW_FLOOR=0.80
MAX_UPLOAD_BYTES=25000000
WEBHOOK_SECRET_SANCTIONS=change-me
WEBHOOK_SECRET_PORTAL=change-me

# ---- Postgres (see docs/POSTGRES.md). Unset = SQLite at VRO_DB_PATH.
# VRO_DATABASE_URL=postgresql://vro_app:password@localhost:5432/vro

# ---- OIDC (see docs/SECURITY.md). Used when VRO_DEV_AUTH=0.
# OIDC_ISSUER=https://login.example.com/realms/bank
# OIDC_AUDIENCE=vro-api
# OIDC_JWKS_URL=https://login.example.com/realms/bank/protocol/openid-connect/certs
# OIDC_ROLE_CLAIM=roles
# OIDC_TENANT_CLAIM=tenant_id

# ---- Rate limits (requests per minute per principal) and observability
# RATE_LIMIT_RPM=120
# RATE_LIMIT_WRITE_RPM=30
# RATE_LIMIT_UPLOAD_RPM=10
# LOG_LEVEL=INFO
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
