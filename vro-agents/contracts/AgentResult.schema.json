     "type": "array"
    },
    "description": {
     "title": "Description",
     "type": "string"
    },
    "domain": {
     "enum": [
      "security",
      "resilience",
      "privacy",
      "financial",
      "contract",
      "concentration",
      "entity",
      "regulatory",
      "screening",
      "document_integrity"
     ],
     "title": "Domain",
     "type": "string"
    },
    "regulation_refs": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Regulation Refs",
     "type": "array"
    },
    "remediation": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Remediation"
    },
    "rule_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
