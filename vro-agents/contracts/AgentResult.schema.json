    },
    "severity": {
     "enum": [
      "INFO",
      "LOW",
      "MEDIUM",
      "HIGH",
      "CRITICAL"
     ],
     "title": "Severity",
     "type": "string"
    },
    "title": {
     "title": "Title",
     "type": "string"
    }
   },
   "required": [
    "domain",
    "severity",
    "title",
    "description",
    "claim_ids"
   ],
   "title": "Finding",
   "type": "object"
  },
  "Question": {
   "additionalProperties": false,
   "properties": {
    "blocking": {
     "default": false,
     "title": "Blocking",
     "type": "boolean"
    },
    "options": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Options"
    },
    "text": {
     "title": "Text",
     "type": "string"
    },
    "to_role": {
     "enum": [
      "analyst",
      "infosec",
      "legal",
      "aml",
      "sponsor",
      "vendor_via_analyst"
     ],
     "title": "To Role",
     "type": "string"
    },
    "why_it_matters": {
     "title": "Why It Matters",
     "type": "string"
    }
   },
   "required": [
    "to_role",
    "text",
    "why_it_matters"
   ],
   "title": "Question",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
  "claims": {
   "default": [],
   "items": {
    "$ref": "#/$defs/Claim"
   },
   "title": "Claims",
   "type": "array"
  },
  "confidence": {
   "default": 0.0,
   "maximum": 1,
   "minimum": 0,
   "title": "Confidence",
   "type": "number"
  },
  "data": {
   "additionalProperties": true,
   "default": {},
   "title": "Data",
   "type": "object"
  },
  "findings": {
   "default": [],
   "items": {
    "$ref": "#/$defs/Finding"
   },
   "title": "Findings",
   "type": "array"
  },
  "flags": {
   "default": [],
   "items": {
    "type": "string"
   },
   "title": "Flags",
   "type": "array"
  },
  "notes": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Notes"
  },
  "questions": {
   "default": [],
   "items": {
    "$ref": "#/$defs/Question"
   },
   "title": "Questions",
   "type": "array"
  },
  "status": {
   "enum": [
    "OK",
    "NEEDS_INPUT",
    "INSUFFICIENT_EVIDENCE",
    "ERROR",
    "REFUSED_UNSAFE_INPUT"
   ],
   "title": "Status",
   "type": "string"
  }
 },
 "required": [
  "status"
 ],
 "title": "AgentResult",
 "type": "object"
}
