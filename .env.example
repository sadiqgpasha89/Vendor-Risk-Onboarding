# Environment Configuration Template
# Copy to .env and update values

# Application
APP_NAME=Vendor Risk Onboarding
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-in-production

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vendor_risk
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORG_ID=your-org-id
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_ENDPOINT=your-azure-endpoint
ANTHROPIC_API_KEY=your-anthropic-key

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# LLMOps Configuration
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=vendor-risk-onboarding
WANDB_API_KEY=your-wandb-key
WANDB_PROJECT=vendor-risk-onboarding

# MLFlow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=vendor-risk-experiments

# Monitoring & Tracing
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
OPENTELEMETRY_ENABLED=true
SENTRY_DSN=your-sentry-dsn

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=300

# Document Processing
PDF_EXTRACT_TIMEOUT=30
MAX_DOCUMENT_SIZE_MB=50
TESSERACT_PATH=/usr/bin/tesseract

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Authentication
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# File Storage
FILE_STORAGE_PATH=/data/uploads
FILE_STORAGE_TYPE=local  # local | s3 | azure

# AWS S3 (if using S3)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET=vendor-risk-bucket
AWS_REGION=us-east-1

# Evaluation
EVALUATION_ENABLED=true
EVALUATION_SAMPLE_SIZE=100
EVALUATION_THRESHOLD=0.8

# Compliance
AUDIT_LOG_ENABLED=true
DATA_RETENTION_DAYS=2555  # 7 years
PII_MASKING_ENABLED=true
